# ─── Application ──────────────────────────────────────────────
APP_NAME=Mettu Karl HIS
APP_ENV=development
APP_DEBUG=false
SECRET_KEY=your-secret-key-min-32-chars-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://his_user:his_password@localhost:5432/mettu_karl_his
POSTGRES_USER=his_user
POSTGRES_PASSWORD=his_password
POSTGRES_DB=mettu_karl_his

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── MinIO (Object Storage) ───────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=mettu-karl-his
MINIO_SECURE=false

# ─── Sentry (Error Tracking) ──────────────────────────────────
SENTRY_DSN=

# ─── CORS & Security Headers ──────────────────────────────────
CORS_ORIGINS=https://mettu-karl-hospital.vercel.app,https://mettu-karl-his.vercel.app
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
ALLOW_DEV_PASSWORD_FALLBACK=false
STORE_CREDENTIAL_VAULT=false

# ─── Email & Notifications ────────────────────────────────────
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@mettukarl.gov.et

# ─── FHIR ─────────────────────────────────────────────────────
FHIR_SERVER_BASE_URL=http://localhost:8000/api/v1/fhir/r4

# ─── Frontend (Next.js public vars) ───────────────────────────
NEXT_PUBLIC_API_URL=https://mettu-karl-his.vercel.app
NEXT_PUBLIC_APP_NAME=Mettu Karl Hospital Information System
INTERNAL_BACKEND_URL=

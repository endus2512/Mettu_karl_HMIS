# ─── Application ──────────────────────────────────────────────
APP_NAME=Mettu Karl HIS
APP_ENV=development
APP_DEBUG=false
SECRET_KEY=your-secret-key-min-32-chars-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://his_user:his_password@localhost:5432/mettu_karl_his
POSTGRES_USER=his_user
POSTGRES_PASSWORD=his_password
POSTGRES_DB=mettu_karl_his

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── MinIO (Object Storage) ───────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=mettu-karl-his
MINIO_SECURE=false

# ─── Sentry (Error Tracking) ──────────────────────────────────
SENTRY_DSN=

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── FHIR ─────────────────────────────────────────────────────
FHIR_SERVER_BASE_URL=http://localhost:8000/api/v1/fhir/r4

# ─── Frontend (Next.js public vars) ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Mettu Karl HIS
